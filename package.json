{
	"name": "mochibooru",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"setup": "bun scripts/setup.ts",
		"dev": "bun run --filter @mochi/web dev",
		"worker": "bun --env-file=.env apps/worker/src/index.ts",
		"build": "bun run --filter @mochi/web build",
		"start": "bun --env-file=.env apps/web/build/index.js",
		"check": "bun run --filter @mochi/web check && bun x --bun tsc --noEmit -p tsconfig.json",
		"test": "bun test packages tests/unit",
		"test:integration": "bun --env-file=.env test tests/integration",
		"test:e2e": "bun --env-file=.env x playwright test",
		"db:generate": "bun --env-file=.env x drizzle-kit generate",
		"db:migrate": "bun --env-file=.env packages/db/src/migrate.ts",
		"admin:promote": "bun --env-file=.env scripts/promote-admin.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@mochi/db": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"@playwright/test": "^1.58.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.0.0",
		"drizzle-kit": "^0.31.9",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"sharp": "^0.34.5",
		"typescript": "^5.9.3"
	}
}
