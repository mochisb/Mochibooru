{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["bun", "node"]
	},
	"include": ["packages/**/*.ts", "apps/worker/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"]
}
