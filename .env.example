# Copy to .env at the repository root. Docker Compose uses these same values.
DATABASE_URL=postgres://mochi:mochi@localhost:5432/mochibooru
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ORIGIN=http://localhost:5173
PORT=5173
BODY_SIZE_LIMIT=105906176
SITE_NAME=Mochibooru
REGISTRATION_OPEN=true
REQUIRE_APPROVAL=false
MAX_UPLOAD_MB=20
STORAGE_DRIVER=local
# Use an absolute path for local development (web and worker share it).
STORAGE_PATH=/absolute/path/to/Mochibooru/data/media
# S3 configuration (required only when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Compose database credentials; change the password before deploying.
POSTGRES_USER=mochi
POSTGRES_PASSWORD=mochi
POSTGRES_DB=mochibooru
